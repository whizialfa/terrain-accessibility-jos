          <Option type="Map">
            <Option type="int" value="2" name="source"/>
            <Option type="QString" value="CASE&#xa;WHEN &quot;highway&quot; = 'trunk' THEN 80&#xa;WHEN &quot;highway&quot; = 'trunk_link' THEN 70&#xa;&#xa;WHEN &quot;highway&quot; = 'primary' THEN 65&#xa;WHEN &quot;highway&quot; = 'primary_link' THEN 55&#xa;&#xa;WHEN &quot;highway&quot; = 'secondary' THEN 50&#xa;WHEN &quot;highway&quot; = 'secondary_link' THEN 45&#xa;&#xa;WHEN &quot;highway&quot; = 'tertiary' THEN 40&#xa;WHEN &quot;highway&quot; = 'tertiary_link' THEN 35&#xa;&#xa;WHEN &quot;highway&quot; = 'residential' THEN 30&#xa;WHEN &quot;highway&quot; = 'living_street' THEN 20&#xa;WHEN &quot;highway&quot; = 'service' THEN 25&#xa;WHEN &quot;highway&quot; = 'unclassified' THEN 30&#xa;&#xa;WHEN &quot;highway&quot; = 'track' THEN 20&#xa;WHEN &quot;highway&quot; = 'path' THEN 10&#xa;WHEN &quot;highway&quot; = 'footway' THEN 5&#xa;WHEN &quot;highway&quot; = 'pedestrian' THEN 5&#xa;WHEN &quot;highway&quot; = 'steps' THEN 2&#xa;&#xa;ELSE 15&#xa;END&#xa;" name="static_value"/>
          </Option>
        </Option>
